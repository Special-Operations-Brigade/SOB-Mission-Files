, _veh] call BIS_fnc_attachToRelative; " \n "    [Seventh_turret_1, _veh] call BIS_fnc_attachToRelative;  " \n "    [Seventh_turret_2, _veh] call BIS_fnc_attachToRelative;  " \n "    [Seventh_turret_3, _veh] call BIS_fnc_attachToRelative;  " \n "    [Seventh_turret_4, _veh] call BIS_fnc_attachToRelative;  " \n "    [Seventh_turret_5, _veh] call BIS_fnc_attachToRelative;  " \n "    [Seventh_turret_6, _veh] call BIS_fnc_attachToRelative;  " \n "    [Seventh_turret_7, _veh] call BIS_fnc_attachToRelative;  " \n "    [Seventh_turret_8, _veh] call BIS_fnc_attachToRelative;  " \n "    [Seventh_turret_9, _veh] call BIS_fnc_attachToRelative;  " \n "    [Seventh_turret_10, _veh] call BIS_fnc_attachToRelative;  " \n "    [Seventh_turret_11, _veh] call BIS_fnc_attachToRelative;  " \n " " \n "     " \n "   }; " \n "  }; " \n "   " \n "  uiSleep 600; " \n "  deleteVehicle Seventh_Turret_1; " \n "  deleteVehicle Seventh_Turret_2; " \n "  deleteVehicle Seventh_Turret_3; " \n "  deleteVehicle Seventh_Turret_4; " \n "  deleteVehicle Seventh_Turret_5; " \n "  deleteVehicle Seventh_Turret_6; " \n "  deleteVehicle Seventh_Turret_7; " \n "  deleteVehicle Seventh_Turret_8; " \n "  deleteVehicle Seventh_Turret_9; " \n "  deleteVehicle Seventh_Turret_10; " \n "  deleteVehicle Seventh_Turret_11; " \n "  deleteVehicle Seventh_Radar_1; " \n "  deleteVehicle Seventh_Logic_1; " \n "  deleteVehicle Seventh_ship_trigger_1; " \n "  deleteVehicle Seventh_UAV; " \n " " \n "  _pos = First_Recusant_1 modelToWorld [0,350,0]; " \n "  _dir = getDir First_Recusant_1; " \n "  _dir = _dir + 180; " \n "  _veh = createVehicle [""CraterLong"", _pos, [], 0, ""CAN_COLLIDE""]; " \n "  _veh setDir _dir; " \n "   " \n "  if (isServer) then { " \n "   private _simpleObject = _veh call BIS_fnc_replaceWithSimpleObject; " \n "  _simpleObject setObjectScale 45.0; _simpleObject setFeatureType 2; " \n "  }; " \n " " \n "  _pos2 = First_Recusant_1 modelToWorld [0,105,0]; " \n "  _dir2 = getDir First_Recusant_1; " \n "  _dir