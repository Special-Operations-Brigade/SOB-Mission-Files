														init="Port_Debug addAction    " \n "[    " \n "    ""Reactivate broken turrets for Port side"",    " \n "    {    " \n "        params [""_target"", ""_caller"", ""_actionId"", ""_arguments""];    " \n "        if (alive Port_Cannon_1) then {   " \n "            PortTurret1 = true;  " \n "   publicVariable ""PortTurret1"";    " \n "        };   " \n "        if (alive Port_Cannon_2) then {   " \n "            PortTurret2 = true;  " \n "   publicVariable ""PortTurret2"";   " \n "        };   " \n "        if (alive Port_Cannon_3) then {   " \n "            PortTurret3 = true;  " \n "   publicVariable ""PortTurret3"";   " \n "        };   " \n "        if (alive Port_Cannon_4) then {   " \n "            PortTurret4 = true;  " \n "   publicVariable ""PortTurret4"";   " \n "        };   " \n "    },    " \n "    nil,    " \n "    1,    " \n "    true,    " \n "    true,    " \n "    """",    " \n "    ""alive Port_Cannon_1 OR alive Port_Cannon_2 OR alive Port_Cannon_3 OR alive Port_Cannon_4"",    " \n "    3,   " \n "    false,   " \n "    """",   " \n "    """"   " \n "];";
														name="Port_Debug";
														disableSimulation=1;
													};
