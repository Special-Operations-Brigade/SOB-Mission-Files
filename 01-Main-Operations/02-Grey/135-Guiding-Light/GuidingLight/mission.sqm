																		init="starboard_Debug addAction    " \n "[    " \n "    ""Reactivate broken turrets for starboard side"",    " \n "    {    " \n "        params [""_target"", ""_caller"", ""_actionId"", ""_arguments""];    " \n "        if (alive starboard_Cannon_1) then {   " \n "            starboardTurret1 = true;  " \n "   publicVariable ""starboardTurret1"";    " \n "        };   " \n "        if (alive starboard_Cannon_2) then {   " \n "            starboardTurret2 = true;  " \n "   publicVariable ""starboardTurret2"";   " \n "        };   " \n "        if (alive starboard_Cannon_3) then {   " \n "            starboardTurret3 = true;  " \n "   publicVariable ""starboardTurret3"";   " \n "        };   " \n "        if (alive starboard_Cannon_4) then {   " \n "            starboardTurret4 = true;  " \n "   publicVariable ""starboardTurret4"";   " \n "        };   " \n "    },    " \n "    nil,    " \n "    1,    " \n "    true,    " \n "    true,    " \n "    """",    " \n "    ""alive starboard_Cannon_1 OR alive starboard_Cannon_2 OR alive starboard_Cannon_3 OR alive starboard_Cannon_4"",    " \n "    3,   " \n "    false,   " \n "    """",   " \n "    """"   " \n "];";
